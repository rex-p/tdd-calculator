{
  "name": "tdd-calculator",
  "version": "1.0.0",
  "description": "String Calculator TDD Kata - Incubyte Assessment",
  "main": "src/StringCalculator.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rex-p/tdd-calculator.git"
  },
  "keywords": ["tdd", "kata", "string-calculator", "incubyte", "jest", "testing"],
  "author": "Rajesh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rex-p/tdd-calculator/issues"
  },
  "homepage": "https://github.com/rex-p/tdd-calculator#readme",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
